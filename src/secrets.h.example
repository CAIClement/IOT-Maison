#pragma once

// ---------------------------------------------------------------------------
// Copier ce fichier en `src/secrets.h` et y mettre les vraies valeurs.
//
// `src/secrets.h` est ignoré par git et ne doit JAMAIS être commité :
// quiconque possede le jeton Blynk peut ouvrir le portail depuis n'importe ou.
// ---------------------------------------------------------------------------

// Fournis par Blynk lors de la creation du template (onglet "Device Info").
#define BLYNK_TEMPLATE_ID   "TMPLxxxxxxxx"
#define BLYNK_TEMPLATE_NAME "Portail"
#define BLYNK_AUTH_TOKEN    "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

// Reseau WiFi domestique (2,4 GHz obligatoire : l'ESP32 ne fait pas de 5 GHz).
#define WIFI_SSID     "NomDeTonWiFi"
#define WIFI_PASSWORD "MotDePasseWiFi"
